<%- include('navbar.ejs') %>

<div class="container-fluid bg-white p-4 shadow-sm mt-4">
    <h3 class="mb-3">Product List</h3>
    <div class="table-responsive">
        <table class="table table-bordered table-striped table-hover">
            <thead class="table-dark text-center">
                <tr>
                    <th>Product ID</th>
                    <th>Category ID</th>
                    <th>Product Name</th>
                    <th>Product Brand</th>
                    <th>Product Details</th>
                    <th>Product Colors</th>
                    <th>Product Main Image</th>
                    <th>Is Highlighted</th>
                    <th>Is Most Selling</th>
                    <th>Action</th>
                </tr>
            </thead>
            
            <tbody class="text-center align-middle">
                <% if(products && products.length > 0) { %>
                    <% products.forEach(function(product) { %>
                        <tr>
                            <td><%= product.product_id %></td>
                            <td><%= product.category_id %></td>
                            <td><%= product.product_name %></td>
                            <td><%= product.product_brand %></td>
                            <td><%= product.product_details %></td>
                            <td><%= product.product_colors %></td>
                            <td>
                                <% if(product.product_main_image) { %>
                                    <img src="/uploads/<%= product.product_main_image %>" style="max-width:120px; height:auto;" alt="product">
                                <% } else { %>
                                    No Image
                                <% } %>
                                
                            </td>
                            
                            <td><%= product.is_highlighted ? "Yes" : "No" %></td>
                            <td><%= product.is_most_selling ? "Yes" : "No" %></td>
<td>
  <a href="/admin/edit_product/<%= product.product_id %>" class="btn btn-sm btn-primary">Edit</a>
  <a href="/admin/add_product_variants/<%= product.product_id %>" class="btn btn-sm btn-primary"> Variants</a>
  <a href="/admin/add_product_images/<%= product.product_id %>" class="btn btn-sm btn-primary"> Images</a>
  <a href="/admin/delete_product/<%= product.product_id %>" class="btn btn-primary mt-3" onclick="return confirm('Are you sure you want to delete this product?');">
    Delete 
</a>

</td>


                        </tr>
                    <% }) %>
                <% } else { %>
                    <tr>
                        <td colspan="10" class="text-center">No products found</td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>

<%- include('footer.ejs') %>
