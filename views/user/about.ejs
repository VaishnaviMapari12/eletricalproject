    <!-- Stats Section -->
   <section class="stats-section py-5 bg-primary text-white">
    <div class="container">
        <div class="row text-center">
            <div class="col-lg-3 col-md-6 mb-4">
                <div class="h2 fw-bold counter" data-target="50000">0</div>
                <p class="mb-0">Happy Customers</p>
            </div>
            <div class="col-lg-3 col-md-6 mb-4">
                <div class="h2 fw-bold counter" data-target="1000">0</div>
                <p class="mb-0">Products</p>
            </div>
            <div class="col-lg-3 col-md-6 mb-4">
                <div class="h2 fw-bold counter" data-target="99.9">0</div>
                <p class="mb-0">Uptime</p>
            </div>
            <div class="col-lg-3 col-md-6 mb-4">
                <div class="h2 fw-bold counter" data-target="8786">0/div>
                <p class="mb-0">Support</p>
            </div>
        </div>
    </div>
</section>
<script>
document.addEventListener("DOMContentLoaded", () => {
    const counters = document.querySelectorAll(".counter");

    counters.forEach(counter => {
        const updateCount = () => {
            const target = parseFloat(counter.getAttribute("data-target"));
            let count = parseFloat(counter.innerText);

            // speed of counting
            const increment = target / 200; // adjust 200 for faster/slower

            if(count < target) {
                counter.innerText = (count + increment).toFixed(target % 1 === 0 ? 0 : 1);
                requestAnimationFrame(updateCount);
            } else {
                counter.innerText = target;
            }
        };
        updateCount();
    });
});
</script>

    
