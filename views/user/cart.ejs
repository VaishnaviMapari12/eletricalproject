<%- include('navbar') %>

<!-- Breadcrumbs -->
<section class="breadcrumb-section py-3 bg-light">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item active">Shopping Cart</li>
            </ol>
        </nav>
    </div>
</section>

<!-- Cart Section -->
<section class="cart-section py-5">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <h2 class="mb-4">Shopping Cart</h2>
            </div>
        </div>
        
        <div class="row">
            <!-- Cart Items -->
            <div class="col-lg-7">
                <% if (carts && carts.length > 0) { %>
                    <% for (var i = 0; i < carts.length; i++) { %>
                        <div class="cart-item mb-3 p-3 border rounded">
                            <div class="row align-items-center">
                                <!-- Product Image -->
                                <div class="col-md-2">
                                    <img src="/uploads/<%= carts[i].product_main_image %>" class="img-fluid" alt="<%= carts[i].product_name %>">
                                </div>

                                <!-- Product Name & Color -->
                                <div class="col-md-4">
                                    <h5 class="mb-1"><%= carts[i].product_name %></h5>
                                    <% if (carts[i].product_colors) { %>
                                        <p class="text-muted mb-0">Color: <%= carts[i].product_colors.split(',')[0].trim() %></p>
                                    <% } %>
                                </div>

                                <!-- Quantity Stepper -->
                                <div class="col-md-2">
                                    <div class="quantity-stepper d-flex align-items-center">
                                        <button type="button" class="btn btn-outline-secondary btn-sm" onclick="decrementQuantity('<%= carts[i].cart_id %>')">-</button>
                                        <input type="number" value="<%= carts[i].quantity %>" min="1" max="10" class="form-control text-center mx-1 qty-input quantity_box" style="width: 60px;" id="quantity_box_<%= carts[i].cart_id %>">
                                        <button type="button" class="btn btn-outline-secondary btn-sm" onclick="incrementQuantity('<%= carts[i].cart_id %>')">+</button>
                                    </div>
                                </div>

                                <!-- Price -->
                                <div class="col-md-2 text-center">
                                    <div class="h6 mb-0">&#8377; <span class="product_total_price"><%= carts[i].variation_price * carts[i].quantity %></span></div>
                                    <small class="text-muted">&#8377; <span class="product_price"><%= carts[i].variation_price %></span> each</small>
                                </div>

                                <!-- Actions -->
                                <div class="col-md-2 text-center">
                                    <a href="/remove_from_cart/<%= carts[i].cart_id %>" class="btn btn-outline-danger btn-sm mb-2">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                    <button class="btn btn-outline-secondary btn-sm mt-2" onclick="moveToWishlist('<%= carts[i].product_id %>')">
                                        <i class="bi bi-heart"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    <% } %>
                <% } else { %>
                    <div class="text-center p-5">
                        <i class="bi bi-cart-x display-4 text-muted"></i>
                        <h4 class="mt-3">Your cart is empty</h4>
                        <p class="text-muted">Looks like you haven’t added anything yet.</p>
                        <a href="/products" class="btn btn-primary">Start Shopping</a>
                    </div>
                <% } %>
            </div>

            <!-- Order Summary -->
            <div class="col-lg-5">
                <div class="order-summary p-4 border rounded" style="background-color:#f8f9fa;">
                    <h5 class="mb-3">Order Summary</h5>
                    
                    <div class="d-flex justify-content-between mb-2">
                        <span>Subtotal</span>
                        <span>&#8377; <span id="subtaotal-price">0</span></span>
                    </div>
                    
                    <div class="d-flex justify-content-between mb-2">
                        <span>Shipping</span>
                        <span class="text-success">Free</span>
                    </div>
                    
                    <div class="d-flex justify-content-between mb-2">
                        <span>Tax</span>
                        <span>&#8377; <span id="tax_price">0</span></span>
                    </div>
                    
                    <hr>
                    
                    <div class="d-flex justify-content-between mb-4">
                        <strong>Total</strong>
                        <strong>&#8377; <span id="taotal_price">0</span></strong>
                    </div>
                    
                    <div class="d-grid gap-2">
                        <a href="/checkout" class="w-100 d-block">
                            <button class="btn btn-primary btn-lg w-100">
                                <i class="bi bi-credit-card me-2"></i>Proceed to Checkout
                            </button>
                        </a>
                        <button class="btn btn-outline-primary" onclick="window.location.href='/products'">
                            <i class="bi bi-arrow-left me-2"></i>Continue Shopping
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
// Increment quantity
function incrementQuantity(cart_id) {
    fetch(`/cart/increment_quantity/${cart_id}`, { method: 'POST' })
    .then(res => res.json())
    .then(data => {
        document.getElementById(`quantity_box_${cart_id}`).value = data.quantity;
        calculateTotals();
    });
}

// Decrement quantity
function decrementQuantity(cart_id) {
    fetch(`/cart/decrement_quantity/${cart_id}`, { method: 'POST' })
    .then(res => res.json())
    .then(data => {
        document.getElementById(`quantity_box_${cart_id}`).value = data.quantity;
        calculateTotals();
    });
}

// Calculate totals
function calculateTotals() {
    let subtotal = 0;
    document.querySelectorAll('.cart-item').forEach(item => {
        const qtyInput = item.querySelector('.quantity_box');
        const quantity = parseInt(qtyInput.value);
        const price = parseFloat(item.querySelector('.product_price').textContent);

        const totalSpan = item.querySelector('.product_total_price');
        const totalPrice = quantity * price;
        totalSpan.textContent = totalPrice.toFixed(2);

        subtotal += totalPrice;
    });

    const tax = Math.round(subtotal * 0.08); // 8% tax
    const total = subtotal + tax;

    document.getElementById('subtaotal-price').textContent = subtotal.toFixed(2);
    document.getElementById('tax_price').textContent = tax.toFixed(2);
    document.getElementById('taotal_price').textContent = total.toFixed(2);
}

// On page load
calculateTotals();
</script>

<%- include('footer') %>
