<%- include('navbar') %>

<section class="breadcrumb-section py-3 bg-light">
  <div class="container">
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item"><a href="/">Home</a></li>
        <li class="breadcrumb-item"><a href="/pro">My Profile</a></li>
        <li class="breadcrumb-item active">Addresses</li>
      </ol>
    </nav>
  </div>
</section>

<section class="addresses-section py-5">
  <div class="container">
    <div class="row">
      <!-- Sidebar -->
      <div class="col-lg-3">
        <div class="profile-card mb-4 text-center">
          <img src="data:image/jpeg;base64," 
               class="profile-avatar mb-2" alt="Profile Picture">
          <h4 class="mb-1"><%= user.first_name %> <%= user.last_name %></h4>
          <p class="text-muted mb-3"><%= user.email %></p>
        </div>

        <div class="profile-menu">
          <ul class="nav flex-column">
            <li class="nav-item"><a class="nav-link" href="/pro"><i class="bi bi-person me-2"></i>Profile Overview</a></li>
            <li class="nav-item"><a class="nav-link" href="/pro/profile_edit"><i class="bi bi-pencil me-2"></i>Edit Profile</a></li>
            <li class="nav-item"><a class="nav-link" href="/pro/profile_password"><i class="bi bi-lock me-2"></i>Change Password</a></li>
            <li class="nav-item"><a class="nav-link" href="/pro/orders"><i class="bi bi-box-seam me-2"></i>My Orders</a></li>
            <li class="nav-item"><a class="nav-link active" href="/pro/addresses"><i class="bi bi-geo-alt me-2"></i>Addresses</a></li>
          </ul>
        </div>
      </div>

      <!-- Addresses Content -->
      <div class="col-lg-9">
        <div class="d-flex justify-content-between align-items-center mb-4">
          <h2>Manage Addresses</h2>
          <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addAddressModal">
            <i class="bi bi-plus me-2"></i>Add New Address
          </button>
        </div>

        <div class="row g-4">
          <% addresses.forEach(function(addr) { %>
          <div class="col-md-6">
            <div class="card h-100">
              <div class="card-header d-flex justify-content-between align-items-center">
                <h6 class="mb-0"><%= addr.cart_type || addr.address_type || 'Home Address' %></h6>
                <% if(addr.is_default) { %>
                  <span class="badge bg-primary">Default</span>
                <% } else { %>
                  <button class="btn btn-outline-primary btn-sm" onclick="setDefault('<%= addr.id %>')">Set as Default</button>
                <% } %>
              </div>
              <div class="card-body">
                <address class="mb-3">
                  <strong><%= addr.first_name %> <%= addr.last_name %></strong><br>
                  <%= addr.address %><br>
                  <%= addr.city %>, <%= addr.state %> <%= addr.zip_code %><br>
                  <%= addr.country || 'India' %>
                </address>
                <p class="text-muted mb-3"><i class="bi bi-telephone me-2"></i><%= addr.phone %></p>
                <div class="d-flex gap-2">
                  <a href="/pro/addresses/edit/<%= addr.id %>" class="btn btn-outline-primary btn-sm">
                    <i class="bi bi-pencil me-1"></i>Edit
                  </a>
                  <a href="/pro/addresses/delete/<%= addr.id %>" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-trash me-1"></i>Delete
                  </a>
                </div>
              </div>
            </div>
          </div>
          <% }) %>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Add Address Modal -->
<div class="modal fade" id="addAddressModal" tabindex="-1">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Add New Address</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
       <form id="addressForm" action="/save-address" method="POST">
  <div class="row">
    <div class="col-md-6 mb-3">
      <label for="cartType" class="form-label">Cart / Address Type *</label>
      <select class="form-select" name="cartType" id="cartType" required>
        <option value="">Select Type</option>
        <option value="Home">Home</option>
        <option value="Work">Work</option>
        <option value="Billing">Billing</option>
        <option value="Other">Other</option>
      </select>
    </div>
    <div class="col-md-6 mb-3">
      <label for="fullName" class="form-label">Full Name *</label>
      <input type="text" class="form-control" name="fullName" id="fullName" required>
    </div>
  </div>
  <div class="mb-3">
    <label for="addressLine1" class="form-label">Address Line 1 *</label>
    <input type="text" class="form-control" name="addressLine1" id="addressLine1" required>
  </div>
  <div class="mb-3">
    <label for="addressLine2" class="form-label">Address Line 2</label>
    <input type="text" class="form-control" name="addressLine2" id="addressLine2">
  </div>
  <div class="row">
    <div class="col-md-4 mb-3">
      <label for="city" class="form-label">City *</label>
      <input type="text" class="form-control" name="city" id="city" required>
    </div>
    <div class="col-md-4 mb-3">
      <label for="state" class="form-label">State *</label>
      <input type="text" class="form-control" name="state" id="state" required>
    </div>
    <div class="col-md-4 mb-3">
      <label for="zipCode" class="form-label">ZIP Code *</label>
      <input type="text" class="form-control" name="zipCode" id="zipCode" required>
    </div>
  </div>
  <div class="mb-3">
    <label for="phone" class="form-label">Phone Number *</label>
    <input type="tel" class="form-control" name="phone" id="phone" required>
  </div>
  <div class="form-check">
    <input class="form-check-input" type="checkbox" name="setAsDefault" id="setAsDefault">
    <label class="form-check-label" for="setAsDefault">Set as default address</label>
  </div>
  <button type="submit" class="btn btn-primary mt-3">Save Address</button>
</form>

      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary" onclick="saveAddress()">Save Address</button>
      </div>
    </div>
  </div>
</div>

<script>
function setDefault(addrId) {
  fetch(`/pro/addresses/set-default/${addrId}`, { method: 'POST' })
    .then(res => res.json())
    .then(data => { if(data.success) location.reload(); })
    .catch(err => console.log(err));
}

function saveAddress() {
  const formData = {
    cart_type: document.getElementById('cartType').value,
    full_name: document.getElementById('fullName').value,
    address1: document.getElementById('addressLine1').value,
    address2: document.getElementById('addressLine2').value,
    city: document.getElementById('city').value,
    state: document.getElementById('state').value,
    zip_code: document.getElementById('zipCode').value,
    phone: document.getElementById('phone').value,
    set_default: document.getElementById('setAsDefault').checked
  };

  fetch('/pro/addresses/add', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(formData)
  }).then(res => res.json())
    .then(data => { if(data.success) location.reload(); })
    .catch(err => console.log(err));
}
</script>

<%- include('footer.ejs') %>
