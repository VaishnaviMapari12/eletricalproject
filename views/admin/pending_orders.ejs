<%- include('navbar.ejs') %>

<div class="container mt-4">
    <h1 class="text-center my-4">Pending Orders</h1>

    <div class="table-responsive">
        <table class="table table-bordered table-hover text-center align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Order ID</th>
                    <th>Order Date</th>
                    <th>Customer Name</th>
                    <th>Address</th>
                    <th>Total Amount</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                <% if (orders.length === 0) { %>
                    <tr>
                        <td colspan="6">No pending orders found.</td>
                    </tr>
                <% } else { %>
                    <% orders.forEach(order => { %>
                        <tr>
                            <td><%= order.order_id %></td>
                            <td><%= order.order_date ? order.order_date.toISOString().split('T')[0] : 'N/A' %></td>
                            <td><%= order.first_name %> <%= order.last_name %></td>
                            <td>
                                <%= order.address %>, <%= order.city %>, <%= order.state %>, <%= order.zip_code %>
                            </td>
                            <td>₹<%= order.total_amount.toLocaleString('en-IN') %></td>
                            <td>
                                <a href="/admin/pending-order/<%= order.order_id %>" class="btn btn-primary btn-sm mb-1">View</a>
                                <a href="/admin/order_details/<%= order.order_id %>" class="btn btn-info btn-sm mb-1">Details</a>
                                <form action="/admin/delete-order/<%= order.order_id %>" method="POST" style="display:inline;">
                                    <button type="submit" class="btn btn-outline-danger btn-sm mb-1">Delete</button>
                                </form>
                            </td>
                        </tr>
                    <% }) %>
                <% } %>
            </tbody>
        </table>
    </div>

    <!-- Centered Button Below Table -->
    <div class="text-center my-4">
        <button class="btn btn-success btn-lg">Process All Pending Orders</button>
    </div>
</div>

<%- include('footer.ejs') %>
