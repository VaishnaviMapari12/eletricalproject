<%- include('navbar') %>

<section class="portfolio-hero py-5 text-center bg-light">
  <div class="container">
    <h1 class="display-5">My Portfolio</h1>
    <p class="lead">Showcasing all my projects by category.</p>
  </div>
</section>

<section class="portfolio-projects py-5">
  <div class="container">

    <!-- Category Filter Buttons -->
    <div class="text-center mb-4">
      <button class="btn btn-outline-primary me-2 filter-btn" data-filter="all">All</button>
      <button class="btn btn-outline-primary me-2 filter-btn" data-filter="mobile">Mobile</button>
      <button class="btn btn-outline-primary me-2 filter-btn" data-filter="laptop">Laptop</button>
      <button class="btn btn-outline-primary me-2 filter-btn" data-filter="tv">TV</button>
      <button class="btn btn-outline-primary me-2 filter-btn" data-filter="headphone">Headphone</button>
      <button class="btn btn-outline-primary me-2 filter-btn" data-filter="charger">Charger</button>
    </div>

    <!-- Projects Grid -->
    <div class="row g-4">
      <% if (projects && projects.length > 0) { %>
        <% projects.forEach(project => { %>
          <div class="col-md-6 col-lg-4 project-card" data-category="<%= project.category %>">
            <div class="card h-100 shadow-sm">
              <div class="project-img-container overflow-hidden">
                <% if (project.main_image) { %>
                  <img src="/uploads/<%= project.main_image %>" class="card-img-top project-img" alt="<%= project.title %>">
                <% } else { %>
                  <img src="/uploads/default.png" class="card-img-top project-img" alt="No Image">
                <% } %>
              </div>
              <div class="card-body">
                <h5 class="card-title"><%= project.title %></h5>
                <p class="card-text"><%= project.short_desc %></p>
              </div>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <p class="text-center">No projects available.</p>
      <% } %>
    </div>

  </div>
</section>

<%- include('footer.ejs') %>

<!-- JS Filter Logic -->
<script>
  const filterButtons = document.querySelectorAll('.filter-btn');
  const projectCards = document.querySelectorAll('.project-card');

  filterButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const filter = btn.getAttribute('data-filter');
      projectCards.forEach(card => {
        if (filter === 'all' || card.getAttribute('data-category') === filter) {
          card.style.display = 'block';
        } else {
          card.style.display = 'none';
        }
      });
    });
  });
</script>

<style>
.project-img-container { height: 250px; overflow: hidden; }
.project-img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s; }
.project-img-container:hover .project-img { transform: scale(1.2); }
.project-card { cursor: pointer; transition: transform 0.3s, box-shadow 0.3s; }
.project-card:hover { transform: translateY(-5px); box-shadow: 0 10px 25px rgba(0,0,0,0.15); }
</style>
