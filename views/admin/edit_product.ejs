<%- include('navbar.ejs') %>

<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-lg-8">
      <div class="card shadow-lg border-0 rounded-4">
        <div class="card-header bg-primary text-white text-center">
          <h3>Edit Product</h3>
        </div>
        <div class="card-body p-4">
          <form action="/admin/update_product/<%= product.product_id %>" method="POST" enctype="multipart/form-data">
            
            <!-- Product Name -->
            <div class="mb-3">
              <label class="form-label fw-semibold">Product Name</label>
              <input type="text" name="product_name" class="form-control" 
                     value="<%= product.product_name %>">
            </div>

            <!-- Category -->
            <div class="mb-3">
              <label class="form-label fw-semibold">Category</label>
              <select name="category_id" class="form-select">
                <% categories.forEach(cat => { %>
                  <option value="<%= cat.category_id %>" 
                    <%= cat.category_id === product.category_id ? 'selected' : '' %>>
                    <%= cat.category_name %>
                  </option>
                <% }) %>
              </select>
            </div>

            <!-- Brand -->
            <div class="mb-3">
              <label class="form-label fw-semibold">Brand</label>
              <input type="text" name="product_brand" class="form-control" 
                     value="<%= product.product_brand %>">
            </div>

            <!-- Details -->
            <div class="mb-3">
              <label class="form-label fw-semibold">Details</label>
              <textarea name="product_details" class="form-control" rows="3"><%= product.product_details %></textarea>
            </div>

            <!-- Colors -->
            <div class="mb-3">
              <label class="form-label fw-semibold">Colors</label>
              <input type="text" name="product_colors" class="form-control" 
                     value="<%= product.product_colors %>">
            </div>

            <!-- Image -->
            <div class="mb-3">
              <label class="form-label fw-semibold">Product Image</label>
              <input type="file" name="product_main_image" class="form-control">
              <% if(product.product_main_image) { %>
                <div class="mt-2">
                  <img src="/uploads/<%= product.product_main_image %>" width="120" class="rounded shadow-sm">
                  <input type="hidden" name="old_image" value="<%= product.product_main_image %>">
                </div>
              <% } %>
            </div>

            <!-- Highlighted -->
            <div class="mb-3">
              <label class="form-label fw-semibold">Highlighted</label>
              <select name="is_highlighted" class="form-select">
                <option value="yes" <%= product.is_highlighted === 'yes' ? 'selected' : '' %>>Yes</option>
                <option value="no" <%= product.is_highlighted === 'no' ? 'selected' : '' %>>No</option>
              </select>
            </div>

            <!-- Most Selling -->
            <div class="mb-3">
              <label class="form-label fw-semibold">Most Selling</label>
              <select name="is_most_selling" class="form-select">
                <option value="yes" <%= product.is_most_selling === 'yes' ? 'selected' : '' %>>Yes</option>
                <option value="no" <%= product.is_most_selling === 'no' ? 'selected' : '' %>>No</option>
              </select>
            </div>

            <!-- Submit -->
            <div class="text-center">
              <button type="submit" class="btn btn-success px-4">Update Product</button>
            </div>

          </form>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('footer.ejs') %>
