
  <!-- Bootstrap 5 JS and jQuery -->
  <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

  <script>
    // Sidebar toggle for mobile
    $(function() {
      $('.sidebar-toggle').on('click', function() {
        $('#adminSidebar').toggleClass('active');
      });

      // Close sidebar when clicking outside on mobile
      $(document).on('click', function(e) {
        if ($(window).width() < 769) {
          if (!$(e.target).closest('#adminSidebar, .sidebar-toggle').length) {
            $('#adminSidebar').removeClass('active');
          }
        }
      });

      // Highlight active link on click
      $('#adminSidebar .nav-link').on('click', function() {
        $('#adminSidebar .nav-link').removeClass('active');
        $(this).addClass('active');
      });
    });
  </script>
</body>
</html>
