<%- include('navbar') %>

<!-- Hero Slider -->
<section class="hero-section py-4">
    <div class="container">
        <div id="heroCarousel" class="carousel slide" data-bs-ride="carousel">

            <!-- Indicators -->
            <div class="carousel-indicators">
                <% if (sliders && sliders.length > 0) { %>
                    <% sliders.forEach((slider, i) => { %>
                        <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="<%= i %>" class="<%= i === 0 ? 'active' : '' %>"></button>
                    <% }) %>
                <% } %>
            </div>

            <!-- Slides -->
            <div class="carousel-inner">
                <% if (sliders && sliders.length > 0) { %>
                    <% sliders.forEach((slider, i) => { %>
                        <div class="carousel-item <%= i === 0 ? 'active' : '' %>">
                            <div class="hero-slide" style="background-image: url('/uploads/<%= slider.slider_image %>'); height:400px; background-size:cover; background-position:center;">
                                <div class="carousel-caption d-none d-md-block text-start" style="left: 50px; right:auto; bottom: 50px;">
                                    <h2 style="font-size: 2.5rem; font-weight: bold; color: #fff;"><%= slider.slider_title %></h2>
                                    <p style="font-size: 1.2rem; color: #fff; max-width: 600px;"><%= slider.slider_description %></p>
                                    <a href="<%= slider.slider_button_link %>" class="btn btn-primary btn-lg"><%= slider.slider_button_text %></a>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                <% } else { %>
                    <div class="carousel-item active">
                        <div class="hero-slide" style="background-color: #ccc; height:400px;">
                            <div class="carousel-caption d-none d-md-block text-start">
                                <h2 style="font-size: 2.5rem; font-weight: bold; color: #333;">No sliders added yet</h2>
                            </div>
                        </div>
                    </div>
                <% } %>
            </div>

            <!-- Controls -->
            <button class="carousel-control-prev" type="button" data-bs-target="#heroCarousel" data-bs-slide="prev">
                <span class="carousel-control-prev-icon"></span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#heroCarousel" data-bs-slide="next">
                <span class="carousel-control-next-icon"></span>
            </button>
        </div>
    </div>
</section>

<!-- Featured Categories -->
<section class="categories-section py-5">
    <div class="container">
        <div class="row mb-4">
            <div class="col-12 text-center">
                <h2>Shop by Category</h2>
            </div>
        </div>
        <div class="row g-4">
            <% categories.forEach(category => { %>
                <div class="col-lg-3 col-md-6">
                    <a href="/product?category=<%= category.category_id %>" class="category-card text-decoration-none">
                        <img src="/uploads/<%= category.category_image %>" class="card-img-top" alt="<%= category.category_name %>">
                        <div class="card-body text-center">
                            <h5><%= category.category_name %></h5>
                            <p class="text-muted mb-0"><%= category.category_description %></p>
                        </div>
                    </a>
                </div>
            <% }) %>
        </div>
    </div>
</section>

<!-- Most Selling Products -->
<section class="best-deals-section py-5 bg-light">
    <div class="container">
        <div class="row mb-4">
            <div class="col text-center">
                <h2>Most Selling</h2>
            </div>
        </div>
        <div class="row g-4">
            <% if (most_selling_products && most_selling_products.length > 0) { %>
                <% most_selling_products.forEach(product => { %>
                    <div class="col-lg-3 col-md-6">
                        <div class="product-card" data-product-id="<%= product.product_id %>" data-product-name="<%= product.product_name %>" data-product-price="<%= product.variation_price %>" data-product-image="/uploads/<%= product.variant_image || 'default.jpg' %>">
                            
                            <a href="/product_details/<%= product.product_id %>/<%= product.product_variant_id %>">
                                <img src="/uploads/<%= product.variant_image || 'default.jpg' %>" class="card-img-top" alt="<%= product.product_name %>">
                            </a>

                            <div class="card-body">
                                <h5 class="product-title">
                                    <a href="/product_details/<%= product.product_id %>/<%= product.product_variant_id %>" class="text-decoration-none text-dark">
                                        <%= product.product_name %>
                                    </a>
                                </h5>

                                <div class="product-price">
                                    <span class="current-price">₹<%= product.variation_price %></span>
                                    <% if (product.variation_market_price) { %>
                                        <span class="old-price">₹<%= product.variation_market_price %></span>
                                    <% } %>
                                </div>

                                <div>Only <%= product.available_stock %> left</div>

                                <div class="d-flex gap-2 mt-2">
                                    <button class="btn btn-add-cart flex-fill"><i class="bi bi-cart-plus me-2"></i>Add to Cart</button>
                                    <button class="btn btn-wishlist"><i class="bi bi-heart"></i></button>
                                </div>
                            </div>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <p class="text-center">No most selling products available.</p>
            <% } %>
        </div>
    </div>
</section>

<!-- Most Highlighted Products -->
<section class="most-highlighted-section py-5 bg-light">
    <div class="container">
        <div class="row mb-4">
            <div class="col text-center">
                <h2>Most Highlighted Products</h2>
            </div>
        </div>
        <div class="row g-4">
            <% if (highlightedProducts && highlightedProducts.length > 0) { %>
                <% highlightedProducts.forEach(product => { %>
                    <div class="col-lg-3 col-md-6">
                        <div class="card h-100 product-card">
                            <a href="/product_details/<%= product.product_id %>/<%= product.product_variant_id %>">
                                <img src="/uploads/<%= product.variant_image || product.product_main_image || 'default.jpg' %>" class="card-img-top" alt="<%= product.product_name %>">
                            </a>
                            <div class="card-body d-flex flex-column">
                                <h5 class="card-title">
                                    <a href="/product_details/<%= product.product_id %>/<%= product.product_variant_id %>" class="text-decoration-none text-dark">
                                        <%= product.product_name %>
                                    </a>
                                </h5>
                                <p class="text-muted mb-2"><%= product.product_brand %></p>

                                <div class="mb-2">
                                    <span class="text-primary fw-bold">₹<%= product.variation_price || 0 %></span>
                                    <% if(product.variation_market_price) { %>
                                        <span class="text-muted text-decoration-line-through">₹<%= product.variation_market_price %></span>
                                    <% } %>
                                </div>

                                <div class="mt-auto">
                                    <a href="/product_details/<%= product.product_id %>/<%= product.product_variant_id %>" class="btn btn-primary w-100">View Product</a>
                                </div>
                            </div>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <p class="text-center">No highlighted products available.</p>
            <% } %>
        </div>
    </div>
</section>

<%- include('footer') %>
