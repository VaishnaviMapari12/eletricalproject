    <li>
      <a href="/admin/slider" class="nav-link text-white"><i class="fas fa-images"></i> Slider</a>
    </li>
    <li>
      <a href="/admin/settings" class="nav-link text-white"><i class="fas fa-sliders-h"></i> Settings</a>

    </li>
     <li>
      <a href="/admin/portfolio" class="nav-link text-white"><i class="fas fa-sign-out-alt"></i>portfolio</a>
    </li>
     <li>
