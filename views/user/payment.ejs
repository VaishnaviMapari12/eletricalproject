<%- include('navbar') %>

  <section class="payment-section py-5">

    <div class="container">

      <div class="row justify-content-center">

        <div class="col-lg-8">

          <!-- ========================================= -->
          <!-- PAYMENT SUCCESS -->
          <!-- ========================================= -->

          <div id="payment-success" class="text-center" style="display:none;">

            <div class="card border-0 shadow-lg">

              <div class="card-body p-5">

                <div class="mb-4">

                  <i class="bi bi-check-circle-fill text-success" style="font-size:4rem;"></i>

                </div>

                <h2 class="text-success mb-3">
                  Payment Successful!
                </h2>

                <p class="lead mb-4">
                  Thank you for your order.
                  Your payment has been processed successfully.
                </p>

                <div class="row mb-4">

                  <!-- ORDER NUMBER -->

                  <div class="col-md-6">

                    <div class="card bg-light">

                      <div class="card-body text-center">

                        <h6>
                          Order Number
                        </h6>

                        <p class="h5 text-primary">

                          #<%= order.order_number || order.order_id %>

                        </p>

                      </div>

                    </div>

                  </div>

                  <!-- TOTAL -->

                  <div class="col-md-6">

                    <div class="card bg-light">

                      <div class="card-body text-center">

                        <h6>
                          Total Amount
                        </h6>

                        <p class="h5 text-success">

                          ₹<%= order.total_amount %>

                        </p>

                      </div>

                    </div>

                  </div>

                </div>

                <div class="alert alert-info">

                  <i class="bi bi-info-circle me-2"></i>

                  <strong>
                    What's next?
                  </strong>

                  Your payment has been completed successfully.

                </div>

                <div class="d-grid gap-2 d-md-flex justify-content-md-center">

                  <a href="/profile-orders" class="btn btn-primary btn-lg">

                    <i class="bi bi-box-seam me-2"></i>

                    Track Your Order

                  </a>

                  <a href="/products" class="btn btn-outline-primary btn-lg">

                    <i class="bi bi-arrow-left me-2"></i>

                    Continue Shopping

                  </a>

                </div>

              </div>

            </div>

          </div>


          <!-- ========================================= -->
          <!-- PAYMENT FORM -->
          <!-- ========================================= -->

          <div id="payment-form">

            <div class="card border-0 shadow-lg">

              <!-- HEADER -->

              <div class="card-header bg-primary text-white">

                <h4 class="mb-0">

                  <i class="bi bi-credit-card me-2"></i>

                  Complete Your Payment

                </h4>

              </div>


              <div class="card-body p-4">


                <!-- ========================================= -->
                <!-- ORDER SUMMARY -->
                <!-- ========================================= -->

                <div class="row mb-4">


                  <!-- PRODUCTS -->

                  <div class="col-md-6">

                    <h6>
                      Order Summary
                    </h6>

                    <% if (orderProducts && orderProducts.length> 0) { %>

                      <% orderProducts.forEach(function(p) { %>

                        <div class="d-flex justify-content-between mb-2">

                          <span>

                            <%= p.product_name %>

                              (<%= p.quantity %>x)

                          </span>

                          <span>

                            ₹<%= p.price %>

                          </span>

                        </div>

                        <% }) %>

                          <% } %>


                            <!-- SHIPPING -->

                            <div class="d-flex justify-content-between">

                              <span>
                                Shipping
                              </span>

                              <span class="text-success">
                                Free
                              </span>

                            </div>


                            <!-- TAX -->

                            <div class="d-flex justify-content-between">

                              <span>
                                Tax
                              </span>

                              <span>

                                ₹<%= order.tax || 0 %>

                              </span>

                            </div>


                            <hr>


                            <!-- TOTAL -->

                            <div class="d-flex justify-content-between">

                              <strong>
                                Total
                              </strong>

                              <strong>

                                ₹<%= order.total_amount %>

                              </strong>

                            </div>

                  </div>


                  <!-- ========================================= -->
                  <!-- SHIPPING ADDRESS -->
                  <!-- ========================================= -->

                  <div class="col-md-6">

                    <h6>
                      Shipping Address
                    </h6>

                    <address class="text-muted">

                      <%= order.shipping_name || '' %>

                        <br>

                        <%= order.shipping_address || '' %>

                          <br>

                          <%= order.shipping_city || '' %>,

                            <%= order.shipping_zip || '' %>

                              <br>

                              <%= order.shipping_country || 'India' %>

                    </address>

                  </div>

                </div>


                <!-- ========================================= -->
                <!-- PAYMENT METHODS -->
                <!-- ========================================= -->

                <div class="mb-4">

                  <h6 class="mb-3">
                    Choose Payment Method
                  </h6>

                  <div class="row g-3">


                    <!-- UPI -->

                    <div class="col-md-6">

                      <div class="payment-option active" data-method="upi">

                        <div class="card h-100 border-primary">

                          <div class="card-body text-center">

                            <i class="bi bi-phone text-primary" style="font-size:2rem;"></i>

                            <h6>
                              UPI Payment
                            </h6>

                            <p class="text-muted small">

                              GPay / PhonePe / Paytm

                            </p>

                          </div>

                        </div>

                      </div>

                    </div>


                    <!-- CARD -->

                    <div class="col-md-6">

                      <div class="payment-option" data-method="card">

                        <div class="card h-100">

                          <div class="card-body text-center">

                            <i class="bi bi-credit-card text-primary" style="font-size:2rem;"></i>

                            <h6>
                              Credit / Debit Card
                            </h6>

                            <p class="text-muted small">

                              Visa / Mastercard / RuPay

                            </p>

                          </div>

                        </div>

                      </div>

                    </div>

                  </div>

                </div>


                <!-- ========================================= -->
                <!-- PAY BUTTON -->
                <!-- ========================================= -->

                <div class="d-grid">

                  <button type="button" id="pay-button" class="btn btn-primary btn-lg">

                    <i class="bi bi-lock-fill me-2"></i>

                    Pay ₹<%= order.total_amount %>

                  </button>

                </div>


                <!-- ERROR / MESSAGE -->

                <div id="payment-message" class="mt-3"></div>


              </div>

            </div>

          </div>

        </div>

      </div>

    </div>

  </section>


  <!-- ========================================= -->
  <!-- RAZORPAY -->
  <!-- ========================================= -->

  <script src="https://checkout.razorpay.com/v1/checkout.js"></script>


  <script>

    document.addEventListener("DOMContentLoaded", function () {

      const button =
        document.getElementById("pay-button");

      const paymentForm =
        document.getElementById("payment-form");

      const paymentSuccess =
        document.getElementById("payment-success");

      const paymentMessage =
        document.getElementById("payment-message");


      if (!button) {

        console.error(
          "Pay button not found"
        );

        return;
      }


      // =========================================
      // ORDER ID
      // =========================================

      const orderId =
        "<%= order.order_id %>";


      console.log(
        "Order ID:",
        orderId
      );


      // =========================================
      // PAY BUTTON
      // =========================================

      button.addEventListener(
        "click",
        async function () {

          button.disabled = true;

          button.innerHTML =
            "Processing Payment...";


          try {


            // =========================================
            // STEP 1
            // CREATE RAZORPAY ORDER
            // =========================================

            console.log(
              "Creating Razorpay order..."
            );


            const createResponse =
              await fetch(
                "/payment/create-payment/" +
                encodeURIComponent(orderId),
                {

                  method: "POST",

                  headers: {

                    "Content-Type":
                      "application/json"

                  }

                }
              );


            const createData =
              await createResponse.json();


            console.log(
              "Create Response:",
              createData
            );


            if (
              !createResponse.ok ||
              !createData.success
            ) {

              throw new Error(
                createData.message ||
                "Unable to create payment order"
              );
            }


            // =========================================
            // CHECK RAZORPAY ORDER
            // =========================================

            if (
              !createData.razorpay_order_id
            ) {

              throw new Error(
                "Razorpay Order ID was not received"
              );
            }


            // =========================================
            // STEP 2
            // RAZORPAY OPTIONS
            // =========================================

            const options = {

              key:
                createData.key,

              amount:
                createData.amount,

              currency:
                createData.currency || "INR",

              name:
                "Electronic Store",

              description:
                "Order Payment",

              order_id:
                createData.razorpay_order_id,


              // =====================================
              // PREFILL
              // =====================================

              prefill: {

                name:
                  "<%= order.shipping_name || '' %>",

                email:
                  "<%= order.email || '' %>",

                contact:
                  "<%= order.shipping_phone || '' %>"

              },


              // =====================================
              // NOTES
              // =====================================

              notes: {

                order_id:
                  String(orderId)

              },


              // =====================================
              // THEME
              // =====================================

              theme: {

                color:
                  "#0d6efd"

              },


              // =====================================
              // PAYMENT SUCCESS
              // =====================================

              handler:
                async function (response) {

                  console.log(
                    "Razorpay Success:",
                    response
                  );


                  try {


                    button.innerHTML =
                      "Verifying Payment...";


                    // =====================================
                    // STEP 3
                    // VERIFY PAYMENT
                    // =====================================

                    const verifyResponse =
                      await fetch(
                        "/payment/verify-payment/" +
                        encodeURIComponent(orderId),
                        {

                          method:
                            "POST",

                          headers: {

                            "Content-Type":
                              "application/json"

                          },

                          body:
                            JSON.stringify({

                              razorpay_payment_id:
                                response.razorpay_payment_id,

                              razorpay_order_id:
                                response.razorpay_order_id,

                              razorpay_signature:
                                response.razorpay_signature

                            })

                        }
                      );


                    const verifyData =
                      await verifyResponse.json();


                    console.log(
                      "Verify Response:",
                      verifyData
                    );


                    // =====================================
                    // PAYMENT VERIFIED
                    // =====================================

                    if (
                      verifyResponse.ok &&
                      verifyData.success
                    ) {


                      paymentForm.style.display =
                        "none";


                      paymentSuccess.style.display =
                        "block";


                    } else {

                      throw new Error(
                        verifyData.message ||
                        "Payment verification failed"
                      );
                    }


                  } catch (error) {

                    console.error(
                      "VERIFY ERROR:",
                      error
                    );


                    paymentMessage.innerHTML = `

                                    <div class="alert alert-danger">

                                        <strong>
                                            Payment Verification Failed
                                        </strong>

                                        <br>

                                        ${error.message}

                                    </div>

                                `;


                    button.disabled =
                      false;


                    button.innerHTML =
                      "Pay ₹<%= order.total_amount %>";

                  }

                }

            };


            // =========================================
            // CREATE RAZORPAY INSTANCE
            // =========================================

            const rzp =
              new Razorpay(options);


            // =========================================
            // PAYMENT FAILED
            // =========================================

            rzp.on(
              "payment.failed",
              function (response) {

                console.error(
                  "Payment Failed:",
                  response.error
                );


                alert(
                  response.error.description ||
                  "Payment failed"
                );


                button.disabled =
                  false;


                button.innerHTML =
                  "Pay ₹<%= order.total_amount %>";

              }
            );


            // =========================================
            // CLOSE PAYMENT POPUP
            // =========================================

            rzp.on(
              "modal.ondismiss",
              function () {

                button.disabled =
                  false;


                button.innerHTML =
                  "Pay ₹<%= order.total_amount %>";

              }
            );


            // =========================================
            // OPEN RAZORPAY
            // =========================================

            rzp.open();

          } catch (error) {

            console.error(
              "PAYMENT ERROR:",
              error
            );


            paymentMessage.innerHTML = `

                    <div class="alert alert-danger">

                        <strong>
                            Payment Error
                        </strong>

                        <br>

                        ${error.message}

                    </div>

                `;


            button.disabled =
              false;


            button.innerHTML =
              "Pay ₹<%= order.total_amount %>";

          }

        }
      );

    });

  </script>


  <%- include('footer') %>