<%- include('navbar') %>

<section class="py-5">
  <div class="container col-md-6">
    <div class="card shadow-sm">
      <div class="card-header bg-warning text-center">Verify OTP</div>
      <div class="card-body">
        <% if(error) { %>
          <div class="alert alert-danger"><%= error %></div>
        <% } %>
        <form method="POST" action="/forgot-password/verify-otp" class="text-center">
          <div class="d-flex justify-content-center gap-2 mb-3">
            <% for(let i=0;i<6;i++){ %>
              <input type="text" maxlength="1" name="otp<%= i+1 %>" class="form-control otp-input text-center fs-4" required>
            <% } %>
          </div>
          <input type="hidden" name="email" value="<%= email %>">
          <button class="btn btn-warning w-100">Verify OTP</button>
        </form>
        <small class="text-center d-block mt-2">
          Didn't receive OTP? <a href="/forgot-password-email">Resend</a>
        </small>
      </div>
    </div>
  </div>
</section>

<style>
.otp-input { width:3rem; height:3rem; border:2px solid #ffc107; border-radius:0.5rem; }
.otp-input:focus { border-color:#fd7e14; box-shadow:0 0 5px #fd7e14; }
</style>

<script>
const otpInputs = document.querySelectorAll('.otp-input');
otpInputs.forEach((input,i)=>{
  input.addEventListener('input',()=>{ if(input.value && i<otpInputs.length-1) otpInputs[i+1].focus(); });
  input.addEventListener('keydown',(e)=>{ if(e.key==='Backspace' && !input.value && i>0) otpInputs[i-1].focus(); });
});
</script>

<%- include('footer') %>
