<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Admin Dashboard</title>
  <!-- Bootstrap 5 CSS -->
   <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/2.5.0/Chart.min.js"></script>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Font Awesome for icons -->
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">

  
  <style>
    /* Sidebar styles */
    #adminSidebar {
      min-width: 220px;
      max-width: 220px;
      min-height: 100vh;
      background: #212529;
      color: #fff;
      position: fixed;
      left: 0;
      top: 0;
      z-index: 100;
      transition: left 0.3s;
    }
    #adminSidebar .nav-link {
      color: #fff;
      border-radius: 0;
      display: flex;
      align-items: center;
      gap: 10px;
      font-weight: 500;
    }
    #adminSidebar .nav-link.active, #adminSidebar .nav-link:hover {
      background: #343a40;
      color: #ffc107;
    }
    #adminContent {
      margin-left: 220px;
      padding: 2rem;
    }
    @media (max-width: 768px) {
      #adminSidebar {
        left: -220px;
      }
      #adminSidebar.active {
        left: 0;
      }
      #adminContent {
        margin-left: 0;
      }
      .sidebar-toggle {
        display: block;
      }
    }
    .sidebar-toggle {
      display: none;
      position: fixed;
      top: 1rem;
      left: 1rem;
      z-index: 200;
      font-size: 1.5rem;
      color: #ffc107;
    }
  </style>
</head>
<body>
  
  <button class="btn sidebar-toggle d-md-none">
    <i class="fas fa-bars"></i>
  </button>
<!-- Sidebar -->
<nav id="adminSidebar" class="d-flex flex-column p-3 bg-dark text-white" style="min-height:100vh;">
  <h3 class="mb-4 text-warning">
    <i class="fas fa-cogs"></i> Admin Panel
  </h3>
  <ul class="nav nav-pills flex-column mb-auto">
