    </li>
    <li>
      <a href="/admin/category" class="nav-link text-white"><i class="fas fa-list"></i> Category</a>
    </li>
    <li>
      <a href="/admin/products" class="nav-link text-white"><i class="fas fa-box"></i> Products</a>
    </li>
    <li>
      <a href="/admin/products_list" class="nav-link text-white"><i class="fas fa-th-list"></i> Products List</a>
    </li>
    <li>
      <a href="/admin/pending_orders" class="nav-link text-white"><i class="fas fa-clock"></i> Pending Orders</a>
    </li>
    <li>
      <a href="/admin/dispatch_orders" class="nav-link text-white"><i class="fas fa-truck"></i> Dispatch Orders</a>
    </li>
