<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ElectroStore - Blog</title>

  <!-- Bootstrap 5.3 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

  <!-- Bootstrap Icons -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

  <style>
    a { text-decoration: none; }
    .blog-section { padding: 50px 0; }
    .blog-img { width: 100%; border-radius: 10px; transition: transform .3s; }
    .blog-img:hover { transform: scale(1.02); }
    .blog-content { padding: 20px; }
  </style>
</head>
<body>
  
  <!-- Navbar Include -->
  <%- include("navbar") %>

  <!-- Blog Page -->
  <div class="container blog-section">
    <h2 class="text-center mb-4">Latest Blog Articles</h2>

    <!-- Portfolio Button -->
    <div class="text-center mb-5">
      <a href="/portfolio" class="btn btn-success btn-lg">View My Portfolio</a>
    </div>

    <!-- Blog 1 -->
    <div class="row mb-5 align-items-center">
      <div class="col-md-6">
        <div class="blog-content">
          <h3>Top 5 Smartphones in 2025</h3>
          <p>Explore the most trending smartphones of 2025 with the latest technology, improved battery life, and amazing cameras.</p>
          <a href="/product_details/101" class="btn btn-primary">Read More</a>
        </div>
      </div>
      <div class="col-md-6 text-center">
        <a href="/product_details/101">
          <img src="https://cartify.novabolt.dev/storage/media/2171/blog-post-5.jpg" alt="Smartphones" class="blog-img">
        </a>
      </div>
    </div>

    <!-- Blog 2 -->
    <div class="row mb-5 align-items-center flex-md-row-reverse">
      <div class="col-md-6">
        <div class="blog-content">
          <h3>How to Choose the Best Laptop</h3>
          <p>Confused about which laptop to buy? Our guide will help you choose the perfect laptop whether for gaming, professional work, or study purposes.</p>
          <a href="/product_details/102" class="btn btn-primary">Read More</a>
        </div>
      </div>
      <div class="col-md-6 text-center">
        <a href="/product_details/102">
          <img src="https://cartify.novabolt.dev/storage/media/977/responsive-images/sony-xbr65a8f-65-inch-4k-ultra-hd-smart-bravia-oled-tv-1___responsive_600_600.jpg" alt="Laptops" class="blog-img">
        </a>
      </div>
    </div>

    <!-- Blog 3 -->
    <div class="row mb-5 align-items-center">
      <div class="col-md-6">
        <div class="blog-content">
          <h3>Best Headphones of 2025</h3>
          <p>Looking for the best headphones? Here’s our list of the top models offering noise cancellation, premium sound quality, and budget-friendly options.</p>
          <a href="/product_details/103" class="btn btn-primary">Read More</a>
        </div>
      </div>
      <div class="col-md-6 text-center">
        <a href="/product_details/103">
          <img src="https://cartify.novabolt.dev/storage/media/2175/blog-post-9.jpg" alt="Headphones" class="blog-img">
        </a>
      </div>
    </div>
  </div>

  <!-- Bootstrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
